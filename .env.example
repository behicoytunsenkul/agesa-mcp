# Mevcut sunucu stack'i (n8n_network + postgres container)
# Postgres: user=root, pass=123456, port=5432
# n8n kendi meta DB'si: n8n
# Firma uygulaması DB'si: firma_asistani  (aynı Postgres içinde ayrı DB)

DATABASE_URL=postgresql://root:123456@127.0.0.1:5432/firma_asistani

# Next host'tan n8n'e
N8N_CHAT_URL=http://127.0.0.1:5678/webhook/firma-asistani-chat-webhook/chat

# Başka cihaz / dış IP ile Next çalışıyorsa webhook'u da IP ile verin:
# N8N_CHAT_URL=http://SUNUCU_IP:5678/webhook/firma-asistani-chat-webhook/chat
