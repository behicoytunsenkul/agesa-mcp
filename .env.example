# === Yerel PostgreSQL (Docker veya native) ===
# Docker compose varsayılanı (host port 5433):
DATABASE_URL=postgresql://agesa:agesa123@127.0.0.1:5433/firma_asistani

# Native Postgres örneği:
# DATABASE_URL=postgresql://postgres:SIFRE@127.0.0.1:5433/firma_asistani

# Neon kullanacaksanız (firewall 5432 engelli ortamlarda WebSocket ile bağlanır):
# DATABASE_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# === n8n Chat Trigger webhook ===
# Lokal n8n:
N8N_CHAT_URL=http://127.0.0.1:5678/webhook/firma-asistani-chat-webhook/chat

# n8n Cloud örneği:
# N8N_CHAT_URL=https://ictworks.app.n8n.cloud/webhook/firma-asistani-chat-webhook/chat
